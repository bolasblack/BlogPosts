<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xml" href="{{meta-url|safe}}"?>
<feed xmlns="http://www.w3.org/2005/Atom"{% if site.lang %} xml:lang="{{site.lang}}"{% endif %}>
  <link href="{{site.url}}" rel="self" type="application/atom+xml" />
  <link href="{{site.url}}" rel="alternate" type="text/html" {% if site.lang %}hreflang="{{site.lang}}" {% endif %}/>
  <updated>{{site.updated-at}}</updated>
  <id>{{feed-id|safe}}</id>
  <title type="html">{{site.title}}</title>
  <subtitle>{{site.description}}</subtitle>
  <author>
    <name>{{site.author-name}}</name>
    <email>{{site.author-email}}</email>
    <uri>{{site.author-uri}}</uri>
  </author>

  {% for post in posts %}
  <entry{% if post.lang %} xml:lang="{{post.lang}}"{% endif %}>
    <title type="html">{{post.title}}</title>
    <link href="{{post.post-url}}" rel="alternate" type="text/html" title="{{post.title}}" />
    <published>{{post.created-at}}</published>
    <updated>{{post.updated-at}}</updated>
    <id>{{post.id-url|safe}}</id>
    <content type="html" xml:base="{{post.post-url|safe}}">{{post.content}}</content>

    <author>
      <name>{{site.author-name}}</name>
      <email>{{site.author-email}}</email>
      <uri>{{site.author-uri}}</uri>
    </author>

    {% if post.category %}
    <category term="{{post.category}}" />
    {% endif %}

    {% for tag in post.tags %}
    <category term="{{tag}}" />
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
